{
  "models": [
    {
      "id": "depth-anything-v2-small",
      "name": "Depth Anything V2 Small",
      "role": "relative inverse depth",
      "repository": "https://huggingface.co/onnx-community/depth-anything-v2-small",
      "revision": "4472b7362082ad9968fee890ca0f1e5aca36b93d",
      "license": "Apache-2.0",
      "precision": "fp16 weights / float32 input and output",
      "filename": "depth-anything-v2-small-fp16.onnx",
      "input": {
        "name": "pixel_values",
        "dtype": "float32",
        "layout": "NCHW",
        "channels": 3,
        "rescale": 0.00392156862745098,
        "mean": [
          0.485,
          0.456,
          0.406
        ],
        "std": [
          0.229,
          0.224,
          0.225
        ],
        "sizeMultiple": 14,
        "targetSize": 518,
        "keepAspectRatio": true,
        "resample": "bicubic"
      },
      "output": {
        "name": "predicted_depth",
        "dtype": "float32",
        "layout": "NHW",
        "interpretation": "Relative inverse depth; larger values are nearer. Do not read metric distances."
      },
      "onnx": {
        "irVersion": 9,
        "opset": 14
      }
    },
    {
      "id": "moge-2-vits-normal",
      "name": "MoGe-2 ViT-S Normal",
      "role": "surface normals and geometry validity",
      "author": "Ruicheng Wang et al. / Microsoft",
      "repository": "https://huggingface.co/Ruicheng/moge-2-vits-normal-onnx",
      "revision": "e50ffda41565591092adea54c6ac83d6212e1e23",
      "license": "MIT; DINOv2 backbone Apache-2.0",
      "precision": "fp32",
      "filename": "moge-2-vits-normal.onnx",
      "inputs": [
        {
          "name": "image",
          "dtype": "float32",
          "layout": "NCHW",
          "channels": 3,
          "range": [
            0,
            1
          ]
        },
        {
          "name": "num_tokens",
          "dtype": "int64",
          "shape": [],
          "recommendedRange": [
            1200,
            2500
          ]
        }
      ],
      "outputs": [
        {
          "name": "points",
          "dtype": "float32",
          "layout": "NHWC",
          "channels": 3
        },
        {
          "name": "normal",
          "dtype": "float32",
          "layout": "NHWC",
          "channels": 3
        },
        {
          "name": "mask",
          "dtype": "float32",
          "layout": "NHW",
          "range": [
            0,
            1
          ]
        },
        {
          "name": "scale",
          "dtype": "float32",
          "shape": [
            1
          ]
        }
      ],
      "coordinates": {
        "input": "OpenCV camera: x right, y down, z forward",
        "toRelight": [
          "x",
          "y",
          "z"
        ]
      },
      "note": "This ONNX export is the raw forward pass; points are affine before focal/shift recovery and reprojection. The relight pipeline uses the directly predicted normals.",
      "onnx": {
        "irVersion": 7,
        "opset": 14
      }
    },
    {
      "id": "shadenet",
      "name": "ShadeNet-3.2-5M",
      "role": "albedo and original shading",
      "author": "Sachin (singam96)",
      "repository": "https://huggingface.co/singam96/ShadeNet-3.2-5M",
      "revision": "5460d5b88c7279cf18b8d698a62497da27e5c267",
      "license": "Apache-2.0",
      "precision": "fp16 weights / float32 input and output",
      "filename": "shadenet-fp16.onnx",
      "input": {
        "name": "input_rgb",
        "dtype": "float32",
        "layout": "NCHW",
        "channels": 3,
        "range": [
          -1,
          1
        ],
        "sizeMultiple": 16,
        "trainingResolution": 384
      },
      "output": {
        "name": "output",
        "dtype": "float32",
        "layout": "NCHW",
        "channels": 8,
        "range": [
          -1,
          1
        ],
        "maps": {
          "albedo": [
            0,
            3
          ],
          "depth": [
            3,
            4
          ],
          "normals": [
            4,
            7
          ],
          "shading": [
            7,
            8
          ]
        }
      },
      "reconstruction": "Decode albedo and shading with (value + 1) / 2; the author reconstructs encoded RGB as albedo * shading.",
      "onnx": {
        "irVersion": 8,
        "opset": 17
      }
    }
  ],
